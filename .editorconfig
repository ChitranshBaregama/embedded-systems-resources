# Keep whitespace consistent across editors. Trailing whitespace in a 400 KB
# markdown file is invisible in review and noisy in every future diff.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Two trailing spaces is a hard line break in markdown, so do not strip.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
